# 磁盘目录（为空则采集根目录 /）
# Linux 示例：
#   - /
#   - /data
paths:
  - /
# 网卡名称（为空则聚合所有网卡）
# 示例：
#   - eth0
#   - en0
interfaceNames:
# 使用情况采集间隔（秒），必须大于 0；系统信息按此间隔的 20 倍上报
interval: 3
# 生产必须使用 wss://，路径必须为 /report，无查询参数
reportUrl: wss://example.com/report
# PKCS8 PEM Ed25519 私钥，普通文件且权限为 0600
privateKeyPath: /opt/swallow-agent/agent.key
# 仅开发允许 loopback ws://，不关闭 WSS 证书校验
devMode: false
# 调试模式
isDebug: false
